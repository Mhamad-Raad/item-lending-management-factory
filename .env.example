# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — copy to /opt/pallet/.env on the VPS (chmod 600). Read by docker-compose.yml.
# Generate secrets with: openssl rand -hex 32   (hex = URL-safe, required inside DATABASE_URLs)
# Escrow EVERY value below in the maintainer's password manager (ARCHITECTURE.md §13.6).
# ─────────────────────────────────────────────────────────────────────────────

# Git commit SHA of the deployed images (managed by deploy/deploy.sh — do not edit by hand)
APP_VERSION=0000000000000000000000000000000000000000
# Public hostname served by Caddy (DNS A/AAAA record must point at the VPS)
APP_DOMAIN=pallets.example.com
# Email for Let's Encrypt account / expiry notices
ACME_EMAIL=maintainer@example.com

# PostgreSQL superuser (never used by the application)
POSTGRES_PASSWORD=change-me-64-hex-chars
# Migration/owner role `pallet_owner` (runs prisma migrate deploy + seeds)
DB_OWNER_PASSWORD=change-me-64-hex-chars
# Runtime role `pallet_app` (least privilege; no UPDATE/DELETE on audit_logs / ledgers)
DB_APP_PASSWORD=change-me-64-hex-chars

# HS256 secret for 15-minute access tokens (≥ 64 chars). Rotating it logs everyone out once.
JWT_ACCESS_SECRET=change-me-at-least-64-characters-long-random-hex-string-0000000000

# First admin, created by the migrate service only when the users table is empty; the account starts with
# mustChangePassword = true. Once any user exists these three are ignored: delete ADMIN_PASSWORD from this file
# after the first login (the migrate service no longer requires it).
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=change-me-min-10-chars

# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Optional API-side error tracking (Sentry SaaS free tier or self-hosted GlitchTip). Empty = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — create `.env` at the repository root containing the block below (uncommented).
# (The API dev script, prisma.config.ts and the seed all read the root .env.)
# Postgres comes from docker-compose.dev.yml (`pnpm db:up`); API + web run on the host.
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV=development
# API_PORT=3000
# DATABASE_URL=postgresql://pallet_app:pallet_app_dev@127.0.0.1:5434/pallet?schema=public
# DATABASE_MIGRATE_URL=postgresql://pallet_owner:pallet_owner_dev@127.0.0.1:5434/pallet?schema=public
# DATABASE_TEST_URL=postgresql://pallet_app:pallet_app_dev@127.0.0.1:5434/pallet_test?schema=public
# DATABASE_TEST_MIGRATE_URL=postgresql://pallet_owner:pallet_owner_dev@127.0.0.1:5434/pallet_test?schema=public
# JWT_ACCESS_SECRET=dev-only-secret-dev-only-secret-dev-only-secret-dev-only-secret-00
# COOKIE_SECURE=false
# TRUST_PROXY_SUBNET=loopback
# UPLOADS_DIR=./.data/uploads
# CORS_DEV_ORIGIN=
# LOG_LEVEL=debug
# ADMIN_USERNAME=admin
# ADMIN_DISPLAY_NAME=Administrator
# ADMIN_PASSWORD=admin-dev-password
