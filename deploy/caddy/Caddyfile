# Pallet System edge proxy (ARCHITECTURE.md §10, §13).
# - Automatic HTTPS (Let's Encrypt); HTTP → HTTPS redirect is automatic.
# - Serves the built web app from /srv, reverse-proxies /api/* to the API.
# - Caddy is the edge: it does NOT trust incoming X-Forwarded-For; it sets it to the real client IP.
{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Vite emits content-hashed files under /assets → cache forever. A file that is not there is a chunk
	# an older page asked for after a deploy replaced it: a plain 404 that is never cached, never
	# index.html (which a browser would cache forever under the chunk's name and fail to run as a
	# script). The app reloads itself once on such a failure (Q81).
	handle /assets/* {
		root * /srv
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		respond @missing 404
		file_server
	}

	handle {
		root * /srv

		# Everything else (index.html, boot-prefs.js, favicon) must revalidate so deploys show up.
		header Cache-Control "no-cache"

		# SPA fallback: unknown paths render index.html (TanStack Router handles the route).
		try_files {path} /index.html
		file_server
	}
}
