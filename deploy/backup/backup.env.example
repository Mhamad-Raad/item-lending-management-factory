# Copy to /etc/pallet/backup.env on the VPS (chmod 600, owner root). Escrow every value in the
# maintainer's password manager — a restore onto a fresh VPS needs ONLY these values + the repo.

# restic repository on an S3-compatible bucket (Backblaze B2 S3 endpoint)
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/pallet-backups
# restic encryption password — losing it makes every backup unreadable
RESTIC_PASSWORD=change-me-generate-with-openssl-rand-base64-48
# Bucket-scoped application key (B2 keyID / applicationKey)
AWS_ACCESS_KEY_ID=0000000000000000000000001
AWS_SECRET_ACCESS_KEY=K000000000000000000000000000000
# healthchecks.io check URLs (one per job)
HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000001
HEALTHCHECKS_DISK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000002
