# Copy to ~/.config/pallet/prune.env on the MAINTAINER'S machine (chmod 600) — never onto the VPS.
# prune.sh also needs restic and jq, and keeps its last run in ~/.config/pallet/prune.state (Q129).
# Escrow every value in the password manager next to /etc/pallet/backup.env (ARCHITECTURE.md §13.6).

# Same repository and encryption password as /etc/pallet/backup.env
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/pallet-backups
RESTIC_PASSWORD=change-me-same-as-backup-env
# The PRUNE key: bucket-scoped, WITH deleteFiles (docs/runbooks/backup-keys.md). Not the server's key.
AWS_ACCESS_KEY_ID=0000000000000000000000002
AWS_SECRET_ACCESS_KEY=K000000000000000000000000000000
# Optional healthchecks.io check (period 31 days) so a forgotten prune is noticed
HEALTHCHECKS_PRUNE_URL=
