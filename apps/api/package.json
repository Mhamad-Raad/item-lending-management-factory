{
  "name": "@pallet/api",
  "version": "0.1.0",
  "private": true,
  "description": "Pallet System API (NestJS + Prisma + PostgreSQL).",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json && pnpm run copy-assets",
    "copy-assets": "mkdir -p dist/modules/auth && cp src/modules/auth/common-passwords.txt dist/modules/auth/",
    "dev": "pnpm run copy-assets && tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --enable-source-maps --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts --passWithNoTests",
    "db:migrate": "prisma migrate dev && prisma db execute --file prisma/sql/grants.sql",
    "db:deploy": "prisma migrate deploy && prisma db execute --file prisma/sql/grants.sql",
    "db:seed": "node --enable-source-maps --env-file-if-exists=../../.env dist/scripts/migrate.js --seed-only",
    "db:seed:demo": "node --enable-source-maps --env-file-if-exists=../../.env dist/scripts/seed-demo.js",
    "db:studio": "prisma studio",
    "reconcile": "node --enable-source-maps --env-file-if-exists=../../.env dist/scripts/reconcile.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "@pallet/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "10.74.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "multer": "2.3.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "supertest": "7.2.2",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.0"
  }
}
